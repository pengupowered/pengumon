# Pengumon Configuration & Credentials
# Copy this file to .env and set your values.
# NEVER commit .env to git or version control!

# Device credentials, per device id (the ids on the Settings page): PENGUMON_DEVICE_<ID>_USERNAME / _PASSWORD (<ID>
# in upper case, '-' as '_'). They are optional: passwords can also come from Podman/Docker secrets
# (/run/secrets/pengumon_<id>_password) or be saved from the dashboard (data/secrets.json); a value set here wins over
# both. docker-compose.yml passes these four into the container; add a line there for any other device id.

# Cable modem / gateway web UI (device "modem")
# PENGUMON_DEVICE_MODEM_USERNAME=admin
# PENGUMON_DEVICE_MODEM_PASSWORD=

# Time zone of the container (the image runs in UTC): quiet hours, the daily route check and the reports' days follow
# it until one is picked under Settings > Display. scripts/deploy.sh sets it from the host.
# TZ=America/New_York

# Access control. Without a token anyone who can reach port 8000 can read the data and change settings.
# PENGUMON_ACCESS_TOKEN=
# Extra Host names the dashboard may be reached under (comma separated; ".example.net" matches subdomains).
# IP addresses, localhost and single-label / .local / .lan names are always allowed.
# PENGUMON_ALLOWED_HOSTS=
# PENGUMON_ALLOWED_ORIGINS=
# PENGUMON_MAX_BODY_BYTES=262144
# Set to 1 only when served over HTTPS (marks the session cookie Secure).
# PENGUMON_COOKIE_SECURE=
# How many days a sign-in lasts (default 30). "Sign out everywhere" in the dashboard ends them all at once.
# PENGUMON_SESSION_MAX_AGE_DAYS=30
# Set to 1 to let people without the token see the dashboard, view only: changing anything (and the path export, the
# device credentials) still needs the token. Off by default; only with PENGUMON_ACCESS_TOKEN set.
# PENGUMON_VIEW_WITHOUT_TOKEN=

# ntfy notifications for incidents
# PENGUMON_NOTIFY_URL=
# PENGUMON_NOTIFY_TOKEN=

# Router (device "router")
# PENGUMON_DEVICE_ROUTER_USERNAME=admin
# PENGUMON_DEVICE_ROUTER_PASSWORD=

# OpenTelemetry export over OTLP/HTTP (unset: nothing is exported). The container uses the host network, so a
# collector on the same host is http://127.0.0.1:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=home
# Grafana's base URL: adds Dashboard / Logs / Traces links to the page header (dashboard uid: pengumon)
# PENGUMON_GRAFANA_URL=https://grafana.lan:3000
